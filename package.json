  "scripts": {
    "dev": "parcel *.html",
    "build": "parcel build *.html --public-url ./",
    "deploy": "yarn build && gh-pages -d dist",
    "format": "prettier --write .",
    "prepare": "husky install",
    "lint": "eslint js/ --fix"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,less}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@parcel/transformer-less": "^2.13.3",
    "@parcel/watcher": "^2.5.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "gh-pages": "^3.2.3",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "less": "^4.2.1",
    "less-loader": "^12.2.0",
    "lint-staged": "^15.2.11",
    "parcel": "^2.13.3",
    "prettier": "^3.4.2",
    "svgo": "^3"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610",
  "dependencies": {}
